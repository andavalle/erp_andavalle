{
  "name": "andavalle-platform",
  "private": true,
  "version": "0.2.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:site": "npm run dev --workspace @andavalle/site",
    "dev:erp": "npm run dev --workspace @andavalle/erp",
    "dev:erp:local": "npm run dev --workspace @andavalle/erp -- --mode localdb",
    "local:admin": "node scripts/create-local-admin.mjs",
    "test:quotations:local": "node scripts/test-local-quotations.mjs",
    "test:contracts:local": "node scripts/test-local-contracts.mjs",
    "test:ss:local": "node scripts/test-local-ss.mjs",
    "test:hs:local": "node scripts/test-local-hs.mjs",
    "test:se:local": "node scripts/test-local-se.mjs",
    "test:he:local": "node scripts/test-local-he.mjs",
    "test:inventory:local": "node scripts/test-local-inventory.mjs",
    "test:counts:local": "node scripts/test-local-counts.mjs",
    "test:lifecycle:local": "node scripts/test-local-lifecycle.mjs",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:site": "npm run build --workspace @andavalle/site",
    "build:erp": "npm run build --workspace @andavalle/erp"
  },
  "engines": { "node": ">=22.12.0" }
}
